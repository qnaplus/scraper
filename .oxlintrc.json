{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/oc/build/**",
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-relative-parent-imports": "error"
  },
  "env": {
    "builtin": true
  }
}